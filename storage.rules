rules_version = '2';
// わが家の食材手帳 — Firebase Storage セキュリティルール
//
// 食材写真は fridges/{fridgeId}/items/{ファイル名} に保存する。
// 読み書きできるのは、その冷蔵庫のメンバーだけ（Firestore 側の
// fridge_members ドキュメントの存在で判定する）。匿名アクセスはなし。
// アップロードは画像のみ・5MB以下に制限する（アプリ側でも検証している）。
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isMember(fridgeId) {
      return signedIn() && firestore.exists(
        /databases/(default)/documents/fridge_members/$(fridgeId + "_" + request.auth.uid));
    }
    match /fridges/{fridgeId}/items/{fileName} {
      allow read: if isMember(fridgeId);
      allow create, update: if isMember(fridgeId)
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isMember(fridgeId);
    }
    // それ以外のパスはすべて禁止
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
